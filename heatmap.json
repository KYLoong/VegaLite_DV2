{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "State-level Natural Increase Rate Heatmap (2016–2025)",
  "width": 600,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/KYLoong/VEGALITE_DV2/main/data/natural_increase_rate_state.csv"
  },
  "mark": "rect",
  "encoding": {
    "x": {"field": "year", "type": "ordinal", "axis": {"title": "Year"}},
    "y": {"field": "state", "type": "ordinal", "axis": {"title": "State"}}, 
    "color": {
      "field": "natural_increase_rate",
      "type": "quantitative",
      "scale": {"scheme": "reds"},
      "legend": {"title": "Natural Increase Rate (%)"}
    },
    "tooltip": [
      {"field": "state", "type": "nominal"},
      {"field": "year", "type": "ordinal"},
      {"field": "natural_increase_rate", "type": "quantitative", "format": ".2f"}
    ]
  }
}