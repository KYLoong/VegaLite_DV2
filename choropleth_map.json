{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1000,
  "height": 400,
  "projection": {
    "type": "mercator",
    "center": [110, 4],
    "scale": 2500
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KYLoong/VEGALITE_DV2/main/malaysia_graticule_10.json",
        "format": { "type": "topojson", "feature": "graticule" }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#cccccc",
        "strokeWidth": 0.8,
        "opacity": 0.6
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KYLoong/VEGALITE_DV2/main/malaysia_topojson.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/KYLoong/VEGALITE_DV2/main/data/population_by_state_2025_normalised.csv"
            },
            "key": "state",
            "fields": ["population_density"]
          }
        }
      ],
      "mark": { "type": "geoshape", "stroke": "white", "strokeWidth": 0.5 },
      "encoding": {
        "color": {
          "field": "population_density",
          "type": "quantitative",
          "title": "Population Density",
          "scale": { "type": "log", "scheme": "blues" }
        },
        "tooltip": [
          { "field": "properties.name", "type": "nominal", "title": "State" },
          {
            "field": "population_density",
            "type": "quantitative",
            "title": "Population Density (people/km²)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 109.5,
            "latitude": 6.0,
            "text": "Population of West Malaysia is denser, East Malaysia is more sparse"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "fontSize": 14,
        "fontWeight": "normal",
        "color": "#333",
        "dx": 0,
        "dy": 0
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "text": { "field": "text" }
      }
    }
  ],
  "config": {
    "view": { "stroke": "transparent" },
    "background": null
  }
}

